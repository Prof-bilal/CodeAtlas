{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,

    "strict": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,

    "noEmit": true,

    "paths": {
      "@prof-bilal/atlas-shared": ["./packages/shared/src/index.ts"],
      "@prof-bilal/atlas-core": ["./packages/core/src/index.ts"],
      "@prof-bilal/atlas-hashing": ["./packages/hashing/src/index.ts"],
      "@prof-bilal/atlas-scanner": ["./packages/scanner/src/index.ts"],
      "@prof-bilal/atlas-parser": ["./packages/parser/src/index.ts"],
      "@prof-bilal/atlas-storage": ["./packages/storage/src/index.ts"],
      "@prof-bilal/atlas-graph": ["./packages/graph/src/index.ts"],
      "@prof-bilal/atlas-context": ["./packages/context/src/index.ts"],
      "@prof-bilal/atlas-cache": ["./packages/cache/src/index.ts"],
      "@prof-bilal/atlas-providers": ["./packages/providers/src/index.ts"],
      "@prof-bilal/atlas-summary": ["./packages/summary/src/index.ts"],
      "@prof-bilal/atlas-search": ["./packages/search/src/index.ts"],
      "@prof-bilal/atlas-sdk": ["./packages/sdk/src/index.ts"],
      "@prof-bilal/atlas-agents": ["./packages/agents/src/index.ts"],
      "@prof-bilal/atlas-usage": ["./packages/usage/src/index.ts"],
      "@prof-bilal/atlas-metrics": ["./packages/metrics/src/index.ts"],
      "@prof-bilal/atlas-toolkit": ["./packages/toolkit/src/index.ts"],
      "@prof-bilal/atlas-mcp": ["./packages/mcp/src/index.ts"],
      "@prof-bilal/atlas-verifier": ["./packages/verifier/src/index.ts"]
    }
  }
}
