{
  "name": "codeatlas-cli",
  "version": "0.4.0-beta.0",
  "description": "CodeAtlas CLI — a local-first AI context engine that scans, parses, and indexes a source tree into a queryable context database for developer tools and AI agents.",
  "author": "CodeAtlas contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prof-bilal/CodeAtlas.git"
  },
  "homepage": "https://github.com/Prof-bilal/CodeAtlas",
  "bugs": {
    "url": "https://github.com/Prof-bilal/CodeAtlas/issues"
  },
  "keywords": [
    "codeatlas",
    "ai",
    "context",
    "code-search",
    "code-index",
    "mcp",
    "agent",
    "cli",
    "local-first"
  ],
  "type": "module",
  "bin": {
    "atlas": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "biome format --write ."
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@atlas/benchmark": "workspace:*",
    "@atlas/mcp": "workspace:*",
    "@atlas/sdk": "workspace:*"
  }
}
