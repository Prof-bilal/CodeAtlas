{
  "name": "codeatlas-cli",
  "version": "0.2.1",
  "description": "Command-line interface for CodeAtlas.",
  "type": "module",
  "bin": {
    "atlas": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "biome format --write ."
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@atlas/mcp": "workspace:*",
    "@atlas/sdk": "workspace:*"
  }
}
