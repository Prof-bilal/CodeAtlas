{
  "name": "@prof-bilal/atlas-chatgpt-plugin",
  "version": "0.5.2",
  "description": "ChatGPT/Codex plugin that exposes CodeAtlas repository intelligence over MCP (stdio + Streamable HTTP).",
  "keywords": [
    "codeatlas",
    "chatgpt",
    "codex",
    "plugin",
    "mcp",
    "model-context-protocol",
    "code-intelligence",
    "repository",
    "architecture",
    "impact-analysis",
    "local-first"
  ],
  "type": "module",
  "bin": {
    "codeatlas-chatgpt-mcp": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "plugin"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "biome format --write ."
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ts-morph": "^28.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@prof-bilal/atlas-mcp": "workspace:^",
    "@prof-bilal/atlas-sdk": "workspace:^"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prof-bilal/CodeAtlas.git",
    "directory": "apps/chatgpt-plugin"
  },
  "homepage": "https://github.com/Prof-bilal/CodeAtlas",
  "bugs": {
    "url": "https://github.com/Prof-bilal/CodeAtlas/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "CodeAtlas contributors"
}
