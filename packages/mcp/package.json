{
  "name": "@atlas/mcp",
  "version": "0.0.0",
  "description": "Model Context Protocol (MCP) server exposing CodeAtlas context to external AI tools.",
  "type": "module",
  "bin": {
    "codeatlas-mcp": "./dist/bin.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "biome format --write ."
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@atlas/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
