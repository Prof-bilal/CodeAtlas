{
  "name": "@atlas/summary",
  "version": "0.0.0",
  "description": "AI summary engine for CodeAtlas.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "biome format --write ."
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@atlas/core": "workspace:*",
    "@atlas/shared": "workspace:*"
  },
  "devDependencies": {
    "@atlas/hashing": "workspace:*"
  }
}
