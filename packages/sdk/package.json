{
  "name": "@prof-bilal/atlas-sdk",
  "version": "0.5.0",
  "description": "Public programmatic API and composition root for CodeAtlas.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "biome format --write ."
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@prof-bilal/atlas-agents": "workspace:*",
    "@prof-bilal/atlas-cache": "workspace:*",
    "@prof-bilal/atlas-context": "workspace:*",
    "@prof-bilal/atlas-core": "workspace:*",
    "@prof-bilal/atlas-graph": "workspace:*",
    "@prof-bilal/atlas-hashing": "workspace:*",
    "@prof-bilal/atlas-parser": "workspace:*",
    "@prof-bilal/atlas-providers": "workspace:*",
    "@prof-bilal/atlas-scanner": "workspace:*",
    "@prof-bilal/atlas-search": "workspace:*",
    "@prof-bilal/atlas-shared": "workspace:*",
    "@prof-bilal/atlas-storage": "workspace:*",
    "@prof-bilal/atlas-summary": "workspace:*",
    "@prof-bilal/atlas-usage": "workspace:*",
    "@prof-bilal/atlas-metrics": "workspace:*",
    "@prof-bilal/atlas-toolkit": "workspace:*",
    "@prof-bilal/atlas-verifier": "workspace:*",
    "@prof-bilal/atlas-benchmark": "workspace:*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prof-bilal/CodeAtlas.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/Prof-bilal/CodeAtlas",
  "bugs": {
    "url": "https://github.com/Prof-bilal/CodeAtlas/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "CodeAtlas contributors"
}
